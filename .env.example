# サーバー側だけで使う秘密値。ブラウザへは渡らない。
# 値は各自が直接設定する（このファイルに実値を書かない）。
OPENAI_API_KEY=
MATTA_DEMO_PIN=

# 任意設定（未設定時は既定値）
# MATTA_CHAT_MODEL=gpt-5.6-luna
# MATTA_EMBEDDING_MODEL=text-embedding-3-small
# MATTA_MIN_SIMILARITY=0.3

# Upstash Vector（Vercel MarketplaceのUpstash連携が自動注入する。
# ローカルは `vercel env pull` で取得するか、Upstashダッシュボードの値を設定する）
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# あれば検索・health確認に権限の小さい読み取り専用トークンを使う（seedには不可）
# UPSTASH_VECTOR_REST_READONLY_TOKEN=

# 検索バックエンドの明示切替（ロールバック手段）。
# 未設定時はUpstash設定があればupstash、なければlocal
# MATTA_SEARCH_BACKEND=upstash または local
